# Copy to .env and adjust. Every value below is the default.
PORT=4000
DATABASE_PATH=data/tracker.db
UPLOAD_DIR=data/uploads

# Set to 1 when running behind a TLS-terminating reverse proxy.
# TRUST_PROXY=1

# The address to listen on. Behind nginx set 127.0.0.1, so the port is only
# reachable through the proxy. Unset means every interface.
# HOST=127.0.0.1

# Set to 1 to never call the ECB; the rate then stays whatever an admin typed.
# DISABLE_FX_REFRESH=1

# Only for a production deployment served over plain HTTP.
# INSECURE_COOKIES=1

# The tracker's own address. The link in sign-in e-mails points here.
# PUBLIC_URL=https://tracker.example.com

# Outgoing e-mail for sign-in. Without it, production refuses to send and
# development prints the message to the console. deploy/setup-mail.sh sets up
# a local Postfix; for a provider's relay add SMTP_USER/SMTP_PASS (and
# SMTP_SECURE=1 for port 465).
# SMTP_HOST=127.0.0.1
# SMTP_PORT=25
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Integration Tracker <noreply@example.com>"

# The address `npm run seed` gives the admin account on a fresh install.
# ADMIN_EMAIL=you@example.com
