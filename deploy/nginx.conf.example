# /etc/nginx/sites-available/integration-tracker
#
# Terminates TLS and forwards everything to the Node process on 127.0.0.1:4000.
# Run `certbot --nginx -d tracker.example.com` after this file is in place; it
# rewrites the server block for HTTPS and adds the redirect from port 80.

server {
    listen 80;
    listen [::]:80;
    server_name tracker.example.com;

    # Attachments are capped at 25 MB in the app (shared/files.js). Leave nginx a
    # little headroom, otherwise an upload dies with a 413 before it reaches Node.
    client_max_body_size 28M;

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;

        # TRUST_PROXY=1 in .env makes the app read these, so sign-in throttling
        # sees the real client IP and secure cookies are set correctly.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 60s;
    }
}
